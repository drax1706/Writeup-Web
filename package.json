{
  "name": "websec-writeup-vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "writeup:new": "node scripts/writeup-new.mjs",
    "writeup:import": "node scripts/writeup-import.mjs",
    "writeup:flag": "node scripts/writeup-flag.mjs",
    "content:check": "node scripts/content-check.mjs",
    "check": "npm run content:check && npm run lint && npm run typecheck && npm test && npm run build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
