# Secrets are server-only. Never prefix them with NEXT_PUBLIC_.
# npm run writeup:flag -- --slug <slug> sets the hash referenced by metadata.json.
# SESSION_SECRET is generated automatically if missing or empty.
SESSION_SECRET=

# Example only: use the exact flagHashEnv from each locked article's metadata.
# WRITEUP_FLAG_HASH_MY_WRITEUP=

# Optional public profile links. HTTPS URLs only; leave blank to hide.
PROFILE_GITHUB_URL=
PROFILE_CV_URL=
